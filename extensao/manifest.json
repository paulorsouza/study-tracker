{
  "manifest_version": 3,
  "name": "Estudos",
  "version": "0.1.0",
  "description": "Salva a aula em que você está e conta o tempo no app de gestão de estudos.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:47823/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Estudos"
  },
  "options_page": "opcoes.html"
}
